<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="start.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="true" />
    <staticContent>
      <mimeMap fileExtension=".WEBMANIFEST" mimeType="application/manifest+json" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Old manual" stopProcessing="true">
          <match url="^manual/(.*)$" />
          <action type="Redirect" url="guide/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>

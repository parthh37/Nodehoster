<?xml version="1.0" encoding="UTF-8"?>
<!-- A trimmed applicationHost.config of an IIS 10 server hosting iisnode apps. -->
<configuration>
    <configSections>
        <sectionGroup name="system.applicationHost" />
    </configSections>
    <system.applicationHost>
        <applicationPools>
            <add name="DefaultAppPool" />
            <add name="NodeApps" managedRuntimeVersion="">
                <processModel identityType="SpecificUser" userName="CONTOSO\svc-node" password="[enc:IISCngProvider:c2VjcmV0:enc]" />
            </add>
            <add name="Docs" managedRuntimeVersion="">
                <processModel identityType="NetworkService" />
            </add>
            <applicationPoolDefaults managedRuntimeVersion="v4.0">
                <processModel identityType="ApplicationPoolIdentity" />
            </applicationPoolDefaults>
        </applicationPools>
        <sites>
            <site name="Default Web Site" id="1">
                <application path="/">
                    <virtualDirectory path="/" physicalPath="%SystemDrive%\inetpub\wwwroot" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="*:80:" />
                </bindings>
            </site>
            <site name="Shop" id="2" serverAutoStart="true">
                <application path="/" applicationPool="NodeApps">
                    <virtualDirectory path="/" physicalPath="C:\sites\shop" />
                    <virtualDirectory path="/images" physicalPath="D:\media\images" />
                </application>
                <application path="/api" applicationPool="NodeApps">
                    <virtualDirectory path="/" physicalPath="C:\sites\shop-api" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="*:80:shop.example.com" />
                    <binding protocol="https" bindingInformation="*:443:shop.example.com" sslFlags="1" certificateHash="3F2A9C" certificateStoreName="My" />
                    <binding protocol="https" bindingInformation="*:443:" />
                    <binding protocol="net.tcp" bindingInformation="808:*" />
                </bindings>
            </site>
            <site name="Docs" id="3" serverAutoStart="false">
                <application path="/" applicationPool="Docs">
                    <virtualDirectory path="/" physicalPath="C:\sites\docs" />
                </application>
                <application path="/legacy">
                    <virtualDirectory path="/" physicalPath="C:\sites\legacy" />
                    <virtualDirectory path="/files" physicalPath="%SystemDrive%\share\files" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="10.0.0.5:8080:docs.example.com" />
                    <binding protocol="http" bindingInformation="[::1]:8081:" />
                </bindings>
            </site>
            <site name="Api Gateway" id="4">
                <application path="/">
                    <virtualDirectory path="/" physicalPath="C:\sites\proxy" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="*:80:api.example.com" />
                </bindings>
            </site>
            <site name="Old" id="5">
                <application path="/">
                    <virtualDirectory path="/" physicalPath="C:\sites\old" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="*:80:old.example.com" />
                </bindings>
            </site>
            <site name="Located" id="6">
                <application path="/">
                    <virtualDirectory path="/" physicalPath="%DATA_DRIVE%\located" />
                </application>
                <bindings>
                    <binding protocol="http" bindingInformation="*:80:located.example.com" />
                </bindings>
            </site>
            <siteDefaults>
                <logFile logFormat="W3C" directory="%SystemDrive%\inetpub\logs\LogFiles" />
            </siteDefaults>
            <applicationDefaults applicationPool="DefaultAppPool" />
        </sites>
    </system.applicationHost>
    <system.webServer>
        <proxy enabled="true" preserveHostHeader="false" />
        <handlers accessPolicy="Read, Script">
            <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
        </handlers>
    </system.webServer>
    <location path="Old">
        <system.webServer>
            <httpRedirect enabled="true" destination="https://new.example.com" httpResponseStatus="Permanent" />
        </system.webServer>
    </location>
    <location path="Located">
        <system.webServer>
            <handlers>
                <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
            </handlers>
            <iisnode nodeProcessCountPerApplication="2" />
        </system.webServer>
    </location>
</configuration>

<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
      </handlers>
      <iisnode nodeProcessCommandLine="&quot;C:\Program Files\nodejs\20.11.1\node.exe&quot; --max-old-space-size=4096"
               nodeProcessCountPerApplication="0"
               gracefulShutdownTimeout="60000"
               node_env="staging"
               configOverrides="iisnode.yml"
               maxConcurrentRequestsPerProcess="1024" />
    </system.webServer>
  </location>
</configuration>

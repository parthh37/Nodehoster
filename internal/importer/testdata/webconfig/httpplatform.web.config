<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\nvm\v22.3.0\node.exe" arguments=".\app.js --color" stdoutLogEnabled="true">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="FEATURE_FLAGS" value="beta" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
